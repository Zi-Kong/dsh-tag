{
  "name": "dsh-chat-tags",
  "version": "0.1.0",
  "private": true,
  "description": "Chat tags: mark selected chat text, colored labels, jump back later",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "chat-tags",
    "bookmarks",
    "annotation",
    "navigation",
    "highlight"
  ],
  "engines": {
    "dsh": "^0.2.3-alpha.2"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "assets",
    "screenshots.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}